# =========================================================
#  AI SMART CREDIT SUITE — .gitignore
#  (Empêche la fuite de données sensibles et fichiers inutiles)
# =========================================================

# --- ENVIRONNEMENT & CLÉS ---
.env
.env.*
!.env.example
.env.local
.env.*.backup
*.key
*.pem
.streamlit/secrets.toml
.aws/

# --- FICHIERS TEMPORAIRES / CACHE ---
__pycache__/
*.pyc
*.pyo
*.pyd
*.log
*.tmp
*.bak

# --- VENV / DEPENDANCES LOCALES ---
venv/
.venv/
env/
ENV/

# --- CONFIGURATION IDE / ÉDITEURS ---
.vscode/
.idea/
.spyderproject
.spyproject
*.sublime-project
*.sublime-workspace

# --- OS SYSTEM FILES ---
.DS_Store
Thumbs.db
desktop.ini

# --- ARCHIVES / SAUVEGARDES ---
*.zip
*.tar
*.gz
*.rar

# --- RAPPORTS / EXPORTS / DATA ---
data/*.csv
data/*.xlsx
data/*.json
data/*.jsonl
data/*.parquet
data/*.sav
reports/*.pdf
reports/*.html
reports/*.docx
reports/*.txt

# --- MODELES & CHECKPOINTS ML ---
# On ignore les modèles volumineux et temporaires, 
# mais on autorise explicitement le logistic_pipeline_best.pkl
model/*.joblib
model/*.h5
model/*.onnx
model/*.pt
model/*.bin
!model/logistic_pipeline_best.pkl
!model/features.pkl
!model/explainer.pkl

# --- LOGS / MONITORING ---
logs/
*.out
*.err

# --- NAVIGATION & RAG CACHE ---
vector_store/
docs_rag/index/
*.faiss
*.npy
*.npz

# --- DOCKER / BUILD ---
build/
dist/

# --- NOTEBOOKS / TEMP FILES ---
*.ipynb_checkpoints/
*.nbconvert/
*.sqlite
*.db

# --- AUTRES TEMP FILES ---
tmp/
temp/
.cache/

# Phase 16: local-only resources and private histories (all nested formats).
/data/
/reports/
/Microsoft/
/audit/phase15_probe.txt
secrets.toml
*.p12
*.pfx
*.keystore
.huggingface/
.hf/
huggingface/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
# Redistribution rights pending; corpus installed separately.
/docs_rag/*.pdf
# Unused local training exports and alternative artifacts.
/model/features*.csv
/model/features*.json
/model/features_smote.pkl
/model/features_weighted.pkl
/model/outputs/
/model/save_explainer_linear.py
/assets/logo.png

/rag_builds/
