# =========================================================
#  AI SMART CREDIT SUITE — ENVIRONMENT CONFIG TEMPLATE
#  (Ce fichier est un modèle public. Ne pas y placer de clés réelles.)
# =========================================================

# =========================
# LLM (Modèles de langage)
# =========================
LLM_PROVIDER=groq
GROQ_API_KEY=__PUT_YOUR_KEY_HERE__          # 🔒 Remplacer par votre clé GROQ
GROQ_MODEL=openai/gpt-oss-20b

# Optionnels (si OpenAI ou Ollama)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# =========================
# Backend FastAPI
# =========================
API_HOST=127.0.0.1
API_PORT=18000
BACKEND_URL=http://127.0.0.1:18000
# API_BASE is an optional alias used when BACKEND_URL is absent.
# Process variables override .env; Docker uses http://api:8000.

# Encodage (évite les erreurs Unicode)
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# =========================
# Streamlit UI
# =========================
WEB_PORT=8501
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

# =========================
# Répertoires locaux
# =========================
DATA_DIR=./data
REPORTS_DIR=./reports
VECTOR_STORE_DIR=./vector_store

# =========================
# Internationalisation (I18N)
# =========================
APP_DEFAULT_LANG=fr
APP_SUPPORTED_LANGS=fr,en
APP_I18N_FALLBACK=en
APP_LOCALE_FR=fr_FR.UTF-8
APP_LOCALE_EN=en_US.UTF-8

# =========================
# UI / Divers
# =========================
APP_BRAND=AI Smart Credit
APP_ENV=local
TZ=Africa/Abidjan

# =========================
# Sécurité / CORS
# =========================
SECRET_KEY=change-me                     # 🔒 À remplacer par une clé unique (openssl rand -hex 32)
CORS_ORIGINS=*                           # Liste ou astérisque pour tout domaine

# =========================
# Modèle Machine Learning
# =========================
MODEL_PATH=model/logistic_pipeline_best.pkl

# LLM : appels bornes ; le premier chargement Ollama local peut etre lent.
LLM_TIMEOUT=60
OLLAMA_TIMEOUT=240

# Recherche Web active : DuckDuckGo uniquement, aucune cle SERPAPI.
# Priorite : secrets Streamlit / environnement, preferences, config.yaml.
# WEB_SEARCH_ENABLED=false
# WEB_ALLOWED_DOMAINS=bceao.int,bis.org
WEB_TIMEOUT=10
# Connexions compatibles optionnelles (sans identifiants dans les URL) :
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Shared backend / Streamlit credential (supply securely in each environment).
INTERSERVICE_SECRET=
# Local API documentation only; disabled by default.
ENABLE_LOCAL_API_DOCS=0
